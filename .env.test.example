# Test Environment Configuration Template
# Copy this file to .env.test for local testing

# =============================================================================
# API CREDENTIALS (MOCK VALUES FOR TESTING)
# =============================================================================
# NEVER use real API keys in tests!
# These are mock values with realistic format for validation testing

# Anthropic API Key (Required)
# Format: sk-ant-{base64-like-string}
# Test value includes realistic length and format
ANTHROPIC_API_KEY=sk-ant-test-mock-key-12345678901234567890123456789012

# Brave Search API Key (Optional)
# Format: BSA{alphanumeric}
# Only needed for web search tool tests
BRAVE_SEARCH_API_KEY=BSAabcdefghijklmnopqrstuvwxyz1234567890ABCD

# =============================================================================
# DATABASE PATHS (TEMPORARY FOR TESTING)
# =============================================================================
# Tests automatically use tmp_path, but you can override for debugging

# SQLite database
# DB_PATH=./test_data/test.db

# ChromaDB vector store
# CHROMA_PATH=./test_data/chroma

# Event log
# EVENTS_PATH=./test_data/events.jsonl

# =============================================================================
# APPLICATION SETTINGS (TEST OVERRIDES)
# =============================================================================

# Log level for test runs (DEBUG for verbose output)
LOG_LEVEL=INFO

# Don't auto-update on startup during tests
UPDATE_ON_STARTUP=false

# =============================================================================
# SERVER CONFIGURATION (TEST ENVIRONMENT)
# =============================================================================

# API server settings (not used in unit tests)
API_HOST=127.0.0.1
API_PORT=8001  # Different from production (8000)

# Frontend URL for CORS (testing)
FRONTEND_URL=http://localhost:5174  # Different from production (5173)

# =============================================================================
# MODEL SELECTION (FAST MODELS FOR TESTING)
# =============================================================================
# Use faster/cheaper models for testing to reduce costs

# Filter model (cheapest, fastest)
DEFAULT_FILTER_MODEL=claude-3-haiku-20240307

# Synthesis model (good quality, fast)
DEFAULT_SYNTHESIS_MODEL=claude-3-5-sonnet-20241022

# Q&A model (best quality)
DEFAULT_QA_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# TESTING NOTES
# =============================================================================
#
# 1. NEVER commit real API keys to version control
# 2. Use pytest fixtures (conftest.py) instead of this file when possible
# 3. This file is for integration tests that need real config loading
# 4. Most unit tests should use monkeypatch fixture for isolation
# 5. Add .env.test to .gitignore if using real keys locally
#
# Test Categories:
# - Unit tests: No .env needed (use monkeypatch)
# - Integration tests: May use this file for realistic config
# - E2E tests: Require real credentials (mark with @pytest.mark.requires_api)
#
# Running Tests:
# $ pytest tests/                    # All tests
# $ pytest tests/ -m unit           # Unit tests only
# $ pytest tests/ -m integration    # Integration tests only
# $ pytest tests/ -m "not slow"     # Exclude slow tests
# $ pytest tests/ --cov=backend     # With coverage report
